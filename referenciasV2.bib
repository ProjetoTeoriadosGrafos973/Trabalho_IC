}
@inproceedings{10.1145/3474198.3478183,
author = {Tan, Chun and Zhang, Jin and Liu, Xianfeng and Zhou, Zhou and Shen, Xiuhong},
title = {Survey of Virtual Machine Deployment Algorithms in Cloud Data Center},
year = {2022},
isbn = {9781450390149},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3474198.3478183},
doi = {10.1145/3474198.3478183},
abstract = {Unreasonable utilization of cloud data center resources has caused a series of problems such as low utilization of data center resources. Optimizing the method of virtual machine deployment is one of the effective ways to solve these problems. Effectively reducing the energy consumption and economic costs of cloud data centers and ensuring high-quality service quality have become the main goals of virtual machine deployment optimization. This article analyzes the deployment of virtual machines in cloud data centers, discusses various methods of virtual machine deployment, summarizes and categorizes virtual machine deployment strategies, that is, from the perspectives of virtual machine deployment optimization goals and virtual machine deployment algorithm types. Classification, where optimization goals include single-objective optimization (such as cost, energy consumption, performance, and SLA default rate) and multi-objective optimization (two-objective optimization, three-objective optimization, and more than three-objective), and the types of virtual machine deployment algorithms include determinism Algorithms, heuristic algorithms, meta-heuristic algorithms, etc. Finally, the future research directions of cloud data center virtual machine deployment optimization and key issues to be solved are given.},
booktitle = {International Conference on Frontiers of Electronics, Information and Computation Technologies},
articleno = {126},
numpages = {7},
keywords = {Cloud computing, Data center, Energy consumption, Virtual machine deployment, Virtualization},
location = {Changsha, China},
series = {ICFEICT 2021}
}
